# ---- База данных ----
# Строка подключения приложения (внутри docker compose хост = postgres)
DATABASE_URL=postgresql+psycopg://sklad:sklad@postgres:5432/sklad
# Параметры контейнера postgres
POSTGRES_USER=sklad
POSTGRES_PASSWORD=смените_этот_пароль
POSTGRES_DB=sklad

# ---- Безопасность ----
# Ключ подписи cookie-сессий. Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=смените_этот_ключ
# Ставить флаг Secure на cookie (1 на сервере с HTTPS, 0 при локальном http://localhost)
SESSION_COOKIE_SECURE=1
# Срок жизни сессии в часах
SESSION_HOURS=14
# Блокировка входа: сколько неверных PIN подряд и на сколько минут
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# ---- Домен и HTTPS (Caddy) ----
# Домен для сертификата, например sklad.example.com. Локально оставьте :80
SITE_ADDRESS=:80

# ---- Google Sheets (необязательно) ----
# ID таблицы из её адреса: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=
# Путь к JSON сервисного аккаунта внутри контейнера, напр. /app/secrets/google.json
GOOGLE_SERVICE_ACCOUNT_FILE=
# Либо сам JSON одной строкой (используется, если файл не задан)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Имя листа, который перезаписывает система
GOOGLE_SHEET_NAME=Остатки из системы
# Период выгрузки в минутах
GOOGLE_SYNC_MINUTES=5

# ---- Бэкапы ----
BACKUP_KEEP_DAYS=30

# ---- Прочее ----
# Часовой пояс для показа дат и расчёта «сегодня»
DISPLAY_TZ=Europe/Moscow
LOG_LEVEL=INFO
# 1 — ставить dev-зависимости в образ (нужно для запуска тестов в контейнере)
INSTALL_DEV=0

# Сколько процессов сайта (больше — быстрее при многих людях, каждый ~100 МБ памяти)
WEB_WORKERS=3
